<?xml version="1.0" encoding="utf-8"?>
<!-- FP-24 test harness, NOT the library: a code-less NativeActivity that hosts
     AndroidVkSurface so ci-android-swapchain.sh can rotate a real window.
     configChanges keeps the SAME ANativeWindow across rotation, so the window
     is resized in place (the OUT_OF_DATE / resize path) instead of recreated. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.reactnativeimpeller.fp24probe"
    android:versionCode="1" android:versionName="1">
  <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="33" />
  <application android:label="rni fp24 probe" android:hasCode="false">
    <activity android:name="android.app.NativeActivity"
        android:exported="true"
        android:screenOrientation="portrait"
        android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|density|uiMode"
        android:theme="@android:style/Theme.NoTitleBar.Fullscreen">
      <meta-data android:name="android.app.lib_name" android:value="fp24probe" />
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
      </intent-filter>
    </activity>
  </application>
</manifest>
