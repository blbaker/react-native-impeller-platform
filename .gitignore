# P2: the vendored toolchain and build tree. All of it is reproducible from
# tools/ (sdk-fetch.sh, hermes-build.sh, engine/rn npm install), so none of it
# belongs in git.
engine/build/
engine/build-asan/
engine/build-tsan/
engine/build-fuzz/
engine/rn/node_modules/
engine/third_party/hermes/
engine/third_party/hermes-build/
# Fetched binary (pinned + sha256-verified by tools/angle-fetch.sh), not source.
engine/third_party/angle-win-x64/
engine/third_party/angle-darwin-arm64/
engine/third_party/glfw/
engine/third_party/x11-sysroot/
engine/third_party/impeller-sdk-android/
engine/build-android-*/
engine/build-linux-*/
probe/build-out/
probe/android/src/main/jniLibs/
engine/third_party/impeller-sdk-custom/
engine/third_party/impeller-sdk-custom-darwin/
# iOS: built on a Mac by tools/impeller-sdk-ios-build.sh / hermes-build-ios.sh, never committed.
engine/third_party/impeller-sdk-ios*/
engine/third_party/hermes-ios/
engine/third_party/impeller-sdk-custom-win/
engine/third_party/impeller-sdk-custom-android/
# Fetched by tools/sdk-fetch-custom.sh (or built by impeller-sdk-custom-build*.sh).
engine/third_party/impeller-sdk-custom-parity*/
engine/build-android-*.log
# fetched by tools/sdk-fetch-win.sh, never committed
engine/third_party/impeller-sdk-win/
engine/build-ios-*
# ffmpeg HEADERS for the linux video backend, from tools/ffmpeg-dev-fetch.sh.
# No trailing slash, so a worktree's symlink to the main checkout's copy is ignored too.
engine/third_party/ffmpeg-dev-linux-x64
# web view: rni-webhelper build output (tools/webhelper-build.sh)
engine/build-webhelper/
engine/build-webhelper-arm64/
engine/build-webhelper-debian/

# tools/package-engine-linux.sh output
dist/
# linux-arm64 cross build inputs (tools/arm64-sysroot.sh, sdk-fetch-custom.sh, ffmpeg8-fetch.sh)
engine/third_party/sysroot-linux-arm64
engine/third_party/impeller-sdk-custom-linux-arm64
engine/third_party/ffmpeg8-linux-*
engine/build-linux-*/
