# P9-B — react-native-svg's Fabric C++ (shadow nodes + prop parsing).
#
# WHAT THIS BUILDS, AND WHAT IT DELIBERATELY DOES NOT
#
# rnsvg's native side is TWO layers, and only one of them is portable:
#
#   1. The FABRIC layer — shadow nodes, prop parsing, component descriptors.
#      Ships as `engine/rn/node_modules/react-native-svg/common/cpp/.../rnsvg/`
#      (the vendor's own portable files) plus the codegen output (10 files,
#      regenerated by tools/gen-rnsvg-codegen.sh into engine/svg/generated/).
#      This is the layer that lets Fabric mount <Svg>/<G>/<Path> and hand us
#      parsed props.
#
#   2. The RENDERING layer — `apple/` (Core Graphics) and `android/` (Canvas
#      Java/Kotlin). That is per-platform by construction and there is no
#      portable version. We do NOT build it. Painting is OURS, in
#      SceneGraph.cpp + engine/svg/SvgPath.{h,cpp} (our own `d`-string
#      parser onto ImpellerPathBuilder, since Impeller ships no SVG path
#      parser and we do not have Skia's SkParsePath here).
#
# So the split is: the vendor owns the component contract, we own the pixels
# — same shape as <Text> (RN owns Paragraph props, ImpellerParagraph paints)
# and this repo's own border/gradient handling.
#
# Prior art (read-only reference, adapted here — not copied byte for byte
# because our paths and target names differ):
# ~/projects/rn-skia-prototype/engine/cmake/RnSvg.cmake
#
# NOTE ON THE INCLUDE ROOT: the vendor's headers include their own generated
# output by its INSTALLED path (`<react/renderer/components/rnsvg/Props.h>`),
# so engine/svg/generated must be on the include path as a ROOT, not as the
# rnsvg directory itself.

set(RNSVG_ROOT
    "${CMAKE_SOURCE_DIR}/rn/node_modules/react-native-svg"
    CACHE PATH "react-native-svg package root")

if(NOT EXISTS "${RNSVG_ROOT}/common/cpp/react/renderer/components/rnsvg/RNSVGShadowNodes.h")
  message(FATAL_ERROR "react-native-svg not found at ${RNSVG_ROOT}. Run: (cd engine/rn && npm install --ignore-scripts)")
endif()

set(RNSVG_GEN "${CMAKE_SOURCE_DIR}/svg/generated")
if(NOT EXISTS "${RNSVG_GEN}/react/renderer/components/rnsvg/Props.h")
  message(FATAL_ERROR
    "rnsvg codegen output missing at ${RNSVG_GEN} — run tools/gen-rnsvg-codegen.sh")
endif()

add_library(rnsvg_common STATIC
  # Codegen output (committed; regenerate with tools/gen-rnsvg-codegen.sh).
  "${RNSVG_GEN}/react/renderer/components/rnsvg/Props.cpp"
  "${RNSVG_GEN}/react/renderer/components/rnsvg/EventEmitters.cpp"
  "${RNSVG_GEN}/react/renderer/components/rnsvg/States.cpp"
  "${RNSVG_GEN}/react/renderer/components/rnsvg/ShadowNodes.cpp"
  "${RNSVG_GEN}/react/renderer/components/rnsvg/ComponentDescriptors.cpp"
  # Vendor's portable Fabric layer.
  "${RNSVG_ROOT}/common/cpp/react/renderer/components/rnsvg/RNSVGShadowNodes.cpp"
  "${RNSVG_ROOT}/common/cpp/react/renderer/components/rnsvg/RNSVGLayoutableShadowNode.cpp"
  "${RNSVG_ROOT}/common/cpp/react/renderer/components/rnsvg/RNSVGImageState.cpp"
  "${RNSVG_ROOT}/common/cpp/react/renderer/components/rnsvg/RNSVGImageShadowNode.cpp"
  # Our own path parser (`d` string -> ImpellerPathBuilder calls).
  "${CMAKE_SOURCE_DIR}/svg/SvgPath.cpp"
)

target_include_directories(rnsvg_common SYSTEM PUBLIC
  "${RNSVG_GEN}"
  "${RNSVG_ROOT}/common/cpp/react/renderer/components/rnsvg")
target_include_directories(rnsvg_common PUBLIC
  "${CMAKE_SOURCE_DIR}"
  "${IMPELLER_SDK}/include")

rni_compile_flags(rnsvg_common EXCEPTIONS RTTI NO_DEPRECATED)

target_link_libraries(rnsvg_common PUBLIC reactcommon_fabric reactcommon_core)
