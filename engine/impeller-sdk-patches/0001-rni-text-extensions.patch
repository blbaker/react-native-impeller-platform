+static txt::PlaceholderAlignment ToTxtType(
+    ImpellerPlaceholderAlignment alignment) {
+  switch (alignment) {
+    case kImpellerPlaceholderAlignmentBaseline:
+      return txt::PlaceholderAlignment::kBaseline;
+    case kImpellerPlaceholderAlignmentAboveBaseline:
+      return txt::PlaceholderAlignment::kAboveBaseline;
+    case kImpellerPlaceholderAlignmentBelowBaseline:
+      return txt::PlaceholderAlignment::kBelowBaseline;
+    case kImpellerPlaceholderAlignmentTop:
+      return txt::PlaceholderAlignment::kTop;
+    case kImpellerPlaceholderAlignmentBottom:
+      return txt::PlaceholderAlignment::kBottom;
+    case kImpellerPlaceholderAlignmentMiddle:
+      return txt::PlaceholderAlignment::kMiddle;
+  }
+  return txt::PlaceholderAlignment::kBaseline;
+}
+
+IMPELLER_EXTERN_C
+void ImpellerParagraphBuilderAddPlaceholder(
+    ImpellerParagraphBuilder paragraph_builder,
+    float width,
+    float height,
+    ImpellerPlaceholderAlignment alignment,
+    float baseline_offset) {
+  GetPeer(paragraph_builder)
+      ->AddPlaceholder(width, height, ToTxtType(alignment), baseline_offset);
+}
+
+IMPELLER_EXTERN_C
+uint32_t ImpellerParagraphGetPlaceholderRects(ImpellerParagraph paragraph,
+                                              ImpellerRect* out_rects,
+                                              uint32_t capacity) {
+  const auto boxes = GetPeer(paragraph)->GetPlaceholderRects();
+  if (out_rects != nullptr) {
+    for (size_t i = 0; i < boxes.size() && i < capacity; i++) {
+      const auto& r = boxes[i].rect;
+      out_rects[i] = ImpellerRect{r.left(), r.top(), r.width(), r.height()};
+    }
+  }
+  return static_cast<uint32_t>(boxes.size());
+}
