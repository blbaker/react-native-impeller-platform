+// Models DoConvertImageToRasterImpeller
+// (flutter/lib/ui/painting/image_encoding_impeller.cc): a blit into a
+// host-visible readback buffer on the context's queue, read once the command
+// buffer completes. Synchronous here: the caller wants the bytes now.
+bool Surface::ReadPixels(void* dst, uint64_t dst_size, bool& out_bgra) const {
+  if (!IsValid() || dst == nullptr) {
+    return false;
+  }
+  auto texture = surface_->GetRenderTarget().GetRenderTargetTexture();
+  if (!texture) {
+    VALIDATION_LOG << "Surface has no render target texture to read back.";
+    return false;
+  }
+  const auto& desc = texture->GetTextureDescriptor();
+  if (desc.format != PixelFormat::kB8G8R8A8UNormInt &&
+      desc.format != PixelFormat::kR8G8B8A8UNormInt) {
+    VALIDATION_LOG << "Readback supports 8-bit RGBA / BGRA targets only.";
+    return false;
+  }
+  const size_t bytes = desc.GetByteSizeOfBaseMipLevel();
+  if (dst_size < bytes) {
+    VALIDATION_LOG << "Readback destination is too small.";
+    return false;
+  }
+  auto context = context_->GetContext();
+  DeviceBufferDescriptor buffer_desc;
+  buffer_desc.storage_mode = StorageMode::kHostVisible;
+  buffer_desc.readback = true;
+  buffer_desc.size = bytes;
+  auto buffer = context->GetResourceAllocator()->CreateBuffer(buffer_desc);
+  auto command_buffer = context->CreateCommandBuffer();
+  if (!buffer || !command_buffer) {
+    return false;
+  }
+  command_buffer->SetLabel("RNI Surface Readback Command Buffer");
+  auto pass = command_buffer->CreateBlitPass();
+  if (!pass || !pass->AddCopy(texture, buffer) || !pass->EncodeCommands()) {
+    return false;
+  }
+  struct Done {
+    fml::CountDownLatch latch{1};
+    CommandBuffer::Status status = CommandBuffer::Status::kError;
+  };
+  auto done = std::make_shared<Done>();
+  if (!context->GetCommandQueue()
+           ->Submit({command_buffer},
+                    [done](CommandBuffer::Status status) {
+                      done->status = status;
+                      done->latch.CountDown();
+                    })
+           .ok()) {
+    return false;
+  }
+  done->latch.Wait();  // RNI: the blit must complete before the copy below.
+  if (done->status != CommandBuffer::Status::kCompleted) {
+    return false;
+  }
+  buffer->Invalidate();
+  std::memcpy(dst, buffer->OnGetContents(), bytes);
+  out_bgra = desc.format == PixelFormat::kB8G8R8A8UNormInt;
+  return true;
+}
