+ImpellerSurface ImpellerSurfaceCreateWrappedMetalTextureNew(
+    ImpellerContext context,
+    void* metal_texture) {
+#if IMPELLER_ENABLE_METAL
+  if (!GetPeer(context)->IsMetal()) {
+    VALIDATION_LOG << "Context is not Metal.";
+    return nullptr;
+  }
+  auto surface = SurfaceMTL::WrapTexture(*GetPeer(context), metal_texture);
+  if (!surface) {
+    return nullptr;
+  }
+  return Create<SurfaceMTL>(*GetPeer(context), std::move(surface)).Leak();
+#else   // IMPELLER_ENABLE_METAL
+  VALIDATION_LOG << "Metal unavailable.";
+  return nullptr;
+#endif  // IMPELLER_ENABLE_METAL
+}
