+std::shared_ptr<impeller::Surface> SurfaceMTL::WrapTexture(
+    Context& context,
+    void* metal_texture) {
+  id<MTLTexture> texture = (__bridge id<MTLTexture>)metal_texture;
+  const auto format =
+      context.GetContext()->GetCapabilities()->GetDefaultColorFormat();
+  if (texture == nil || texture.textureType != MTLTextureType2D ||
+      texture.pixelFormat != ToMTLPixelFormat(format) ||
+      (texture.usage & MTLTextureUsageRenderTarget) == 0) {
+    VALIDATION_LOG << "Texture is not a 2D render target in the context's "
+                      "default color format.";
+    return nullptr;
+  }
+  return impeller::SurfaceMTL::MakeFromTexture(
+      context.GetContext(), texture,
+      reinterpret_cast<interop::ContextMTL*>(&context)->GetSwapchainTransients(),
+      std::nullopt, nil);
+}
