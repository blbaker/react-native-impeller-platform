+// react-native-impeller extension (patch 0004): out-of-band swapchain size and
+// drawable size readback. Not part of upstream Impeller; test with #ifdef.
+#define IMPELLER_RNI_VK_SWAPCHAIN_SIZE 1
+
+//------------------------------------------------------------------------------
+/// @brief      Tell the swapchain the size of the window it presents to. The
+///             next acquire recreates the swapchain at this size when it
+///             differs (KHRSwapchainVK::UpdateSurfaceSize). Android must call
+///             this: the KHR swapchain never reads the surface extent there,
+///             and the interop swapchain is created at 1x1.
+///
+IMPELLER_EXPORT
+void ImpellerVulkanSwapchainSetSize(
+    ImpellerVulkanSwapchain IMPELLER_NONNULL swapchain,
