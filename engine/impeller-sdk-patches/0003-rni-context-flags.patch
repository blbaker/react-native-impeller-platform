+// react-native-impeller extension (patch 0003): impeller::Flags for new
+// contexts. Not part of upstream Impeller; test with #ifdef.
+#define IMPELLER_RNI_CONTEXT_FLAGS 1
+
+/// Bits of the `flags` argument of `ImpellerContextSetDefaultFlags`.
+typedef enum ImpellerContextFlagBits {
+  /// impeller::Flags::use_sdfs: analytic SDF anti-aliasing for circles,
+  /// ovals, rects, rounded rects and lines (Canvas::Draw*).
+  kImpellerContextFlagUseSDFs = 1u << 0,
+} ImpellerContextFlagBits;
+
+//------------------------------------------------------------------------------
+/// @brief      Set the flags (`ImpellerContextFlagBits`) that every context
+///             created AFTER this call is built with, on any backend.
+///             Contexts that already exist keep their flags. Thread-safe.
+///             Unknown bits are ignored.
+///
+IMPELLER_EXPORT
+void ImpellerContextSetDefaultFlags(uint32_t flags);
+
+//------------------------------------------------------------------------------
+/// @brief      The flags `ImpellerContextSetDefaultFlags` last set (0 if never).
+///
+IMPELLER_EXPORT
+uint32_t ImpellerContextGetDefaultFlags(void);
+
+//------------------------------------------------------------------------------
+/// @brief      The flags the context was actually created with, read back from
+///             the renderer context (`ImpellerContextFlagBits`).
+///
+IMPELLER_EXPORT
+uint32_t ImpellerContextGetFlags(ImpellerContext IMPELLER_NONNULL context);
+
 //------------------------------------------------------------------------------
 /// @brief      Create a Vulkan context using the provided Vulkan Settings.
 ///
diff --git a/engine/src/flutter/impeller/toolkit/interop/impeller.cc b/engine/src/flutter/impeller/toolkit/interop/impeller.cc
--- a/engine/src/flutter/impeller/toolkit/interop/impeller.cc
+++ b/engine/src/flutter/impeller/toolkit/interop/impeller.cc
@@ -167,6 +167,28 @@
 #endif  // IMPELLER_ENABLE_VULKAN
 }
 
+static uint32_t FlagsToBits(const Flags& flags) {
+  return flags.use_sdfs ? kImpellerContextFlagUseSDFs : 0u;
+}
+
+IMPELLER_EXTERN_C
+void ImpellerContextSetDefaultFlags(uint32_t flags) {
+  Flags impeller_flags;
+  impeller_flags.use_sdfs = (flags & kImpellerContextFlagUseSDFs) != 0;
+  Context::SetDefaultFlags(impeller_flags);
+}
+
+IMPELLER_EXTERN_C
+uint32_t ImpellerContextGetDefaultFlags() {
+  return FlagsToBits(Context::GetDefaultFlags());
+}
+
+IMPELLER_EXTERN_C
+uint32_t ImpellerContextGetFlags(ImpellerContext context) {
+  auto impeller_context = GetPeer(context)->GetContext();
+  return impeller_context ? FlagsToBits(impeller_context->GetFlags()) : 0u;
+}
+
 IMPELLER_EXTERN_C
 void ImpellerContextRetain(ImpellerContext context) {
   ObjectBase::SafeRetain(context);
